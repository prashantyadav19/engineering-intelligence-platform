# Copy this file to .env and fill in real values. Never commit .env.
EIP_ENVIRONMENT=local
EIP_LOG_LEVEL=DEBUG
EIP_DATABASE_URL=postgresql+asyncpg://eip:eip@localhost:5432/eip
EIP_REDIS_URL=redis://localhost:6379/0
EIP_JIRA_BASE_URL=https://your-site.atlassian.net
EIP_JIRA_EMAIL=you@example.com
EIP_JIRA_API_TOKEN=
EIP_JIRA_PROJECT_KEYS=["PAY"]
EIP_JIRA_WEBHOOK_SECRET=change-me

EIP_GITHUB_TOKEN=
EIP_GITHUB_REPOS=["prashantyadav19/engineering-intelligence-platform"]
EIP_GITHUB_WEBHOOK_SECRET=change-me

EIP_AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
